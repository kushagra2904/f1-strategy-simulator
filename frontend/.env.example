# Base URL of the F1 Strategy Simulator backend API.
# Copy this file to `.env` and adjust as needed.
#
# Local development (backend run with: uvicorn main:app --port 8000):
#   VITE_API_BASE=http://localhost:8000
#
# If unset, the app falls back to the deployed Render backend.
VITE_API_BASE=http://localhost:8000
